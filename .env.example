# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Nota: Copia este archivo a .env.local y reemplaza los valores con tus credenciales reales
# Las variables que empiezan con NEXT_PUBLIC_ están disponibles en el cliente
# Nunca compartas tus credenciales reales en repositorios públicos
